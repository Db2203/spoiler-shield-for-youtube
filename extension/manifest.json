{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Blocker",
  "version": "1.0.1",
  "description": "Hides GTA 6 videos, Shorts, comments and search suggestions on YouTube. Runs entirely offline.",
  "homepage_url": "https://github.com/Db2203/gta6-spoiler-blocker",
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-spoiler-blocker@db2203.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "css": [
        "content/hide.css"
      ],
      "js": [
        "content/matcher.js",
        "content/selectors.js",
        "content/settings.js",
        "content/scanner.js",
        "content/watch-guard.js",
        "content/blur.js",
        "content/main.js"
      ]
    }
  ],
  "action": {
    "default_title": "GTA 6 Spoiler Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  }
}
