{
  "manifest_version": 3,
  "name": "Spoiler Shield for YouTube",
  "version": "1.1.3",
  "description": "Hides videos, Shorts, comments and search suggestions that match your keywords, and blocks matching video pages. Ships with a GTA 6 preset. Runs entirely offline.",
  "homepage_url": "https://github.com/Db2203/spoiler-shield-for-youtube",
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-spoiler-blocker@db2203.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "css": [
        "content/hide.css"
      ],
      "js": [
        "content/matcher.js",
        "content/selectors.js",
        "content/settings.js",
        "content/scanner.js",
        "content/watch-guard.js",
        "content/blur.js",
        "content/main.js"
      ]
    }
  ],
  "action": {
    "default_title": "Spoiler Shield for YouTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
